rules_version = '2';
// Regole di Firestore per Rig Book: ognuno legge e scrive solo i propri pezzi (users/{uid}/items/{id}).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/items/{item} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['i', 't', 'x', 'd', 's'])
        && request.resource.data.i is string && request.resource.data.i.size() <= 100
        && request.resource.data.t is int
        && request.resource.data.x is bool
        && request.resource.data.d is string && request.resource.data.d.size() <= 100000
        && request.resource.data.s == request.time;
    }
  }
}
